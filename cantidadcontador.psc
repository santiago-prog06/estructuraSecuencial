Algoritmo cantidadcontador
	definir cantidadTerminos, contadorNumeros Como Entero
	Escribir " ingrese la cantidad de terminos: "
	Leer cantidadTerminos
	termino = 1
	Para contadorNumeros<- 1 Hasta cantidadTerminos Con Paso 1 Hacer
		Escribir termino
		termino = termino + 2
	Fin Para
FinAlgoritmo
