Algoritmo medida
	definir n, cm, yd, mt, pie, pl Como Real
	Escribir "ingresa una medida"
	Leer n
	Escribir "tu medida esta representado en los siguientes valores" n
	cm<-n
	yd<-cm*0.0109361
	mt<-cm*0.01
	pie<-cm*0.0328084
	pl<-cm*0.393701
	Escribir " tu medida en yardas es " yd
	Escribir " tu medida en metros es " mt
	Escribir " tu medida en pies es " pie
	Escribir " tu medida en pulgadas es " pl
FinAlgoritmo
