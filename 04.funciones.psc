Algoritmo funciones
	Definir num, seno, coseno, tangente Como Real
	Definir raizz, logaritmoNatural, logaritmo100 Como Real
	Escribir "ingrese un num" 
	Leer num
	seno = sen (num)
	coseno = cos (num)
	tangente = tan (num)
	raizz = RC (num)
	logaritmoNatural = ln (num)
	logaritmo100 = ln (num)/ln (10)
	Escribir " El seno de el numero es " seno
	Escribir " El coseno de el numero es " coseno
	Escribir " La tangente de el numero es " tangente
	Escribir " La raiz de el numero es " raizz
	Escribir " El Logaritmo natural de el numero es " logaritmoNatural
	Escribir " El Logaritmo 10 de el numero es " logaritmo100
	
	
	
FinAlgoritmo
